generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Roles {
  ADMIN
  MANAGER
  OPERATOR
}

enum MovementType {
  IN
  OUT
  TRANSFER
  ADJUSTMENT
}

enum Status {
  DRAFT
  VALIDATED 
  CANCELLED
}

enum InventoryStatut {
  DRAFT
  VALIDATED
}

model User { 
  id    String     @id @default(uuid()) @db.Uuid
  email String  @unique
  name String
  firstname String
  passwordhashed String
  role           Roles @default(OPERATOR)
  createdAt      DateTime @default(now())
  updatedAt DateTime @updatedAt

  movements StockMovement[]

  inventories Inventory[]
} 

model Product { 
  id    String     @id @default(uuid()) @db.Uuid 
  reference String @unique 
  name String 
  description String 
  barcode String? @unique 
  unit String 
  minimumStock Int 
  active Boolean @default(true) 
  createdAt      DateTime @default(now()) 
  updatedAt DateTime @updatedAt 
  
  stocks Stock[]

  movements StockMovement[]

  productSuppliers ProductSupplier[]

  receptionLines ReceptionLine[]

  inventoryItems InventoryItem[]
}

model ProductSupplier {
  productId String @db.Uuid
  supplierId String @db.Uuid
  product Product @relation(fields: [productId], references: [id])
  Supplier Supplier @relation(fields: [supplierId], references: [id])

  @@id([productId, supplierId])
}

  model Supplier {
    id    String     @id @default(uuid()) @db.Uuid
    name String
    email String @unique
    phone String @unique
    address String
    city String
    postalCode String
    country String
    createdAt      DateTime @default(now()) 
    updatedAt DateTime @updatedAt
  
    receptions Reception[]

    productSuppliers ProductSupplier[]
}

  model Warehouse {
    id    String     @id @default(uuid()) @db.Uuid
    name String
    address String
    createdAt      DateTime @default(now()) 
    updatedAt DateTime @updatedAt

    zones Zone[]
}

  model Zone {
    id    String     @id @default(uuid()) @db.Uuid
    name String
    code String @unique
    warehouseId String @db.Uuid
    warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
    createdAt      DateTime @default(now()) 
    updatedAt DateTime @updatedAt

    locations Location[]
}

  model Location {
    id    String     @id @default(uuid()) @db.Uuid
    name String
    code String @unique
    capacity Int
    active Boolean @default(true)
    zoneId String @db.Uuid
    zone Zone @relation(fields: [zoneId], references: [id])
    createdAt      DateTime @default(now()) 
    updatedAt DateTime @updatedAt
  
    stocks Stock[]

    movementsSources StockMovement[] @relation("MovementSource")

    movementsLocations StockMovement[] @relation("MovementDestination")

    receptionLines ReceptionLine[]

    inventories Inventory[]
}

  model Stock {
  id         String @id @default(uuid()) @db.Uuid
  quantity   Int    @default(0)
  productId  String   @db.Uuid
  locationId String   @db.Uuid
  product Product @relation(fields: [productId], references: [id])
  location Location @relation(fields: [locationId], references: [id])
  createdAt      DateTime @default(now()) 
  updatedAt DateTime @updatedAt
  @@unique([productId, locationId])
}

model StockMovement {
  id                   String       @id @default(uuid()) @db.Uuid
  type                 MovementType
  quantity             Int
  reason               String?
  productId String @db.Uuid
  sourceLocationId String? @db.Uuid
  destinationLocationId String? @db.Uuid
  userId String @db.Uuid
  product Product @relation(fields: [productId], references: [id])
  sourceLocation       Location?    @relation("MovementSource", fields: [sourceLocationId], references: [id])
  destinationLocation  Location?    @relation("MovementDestination", fields: [destinationLocationId], references: [id])
  user User @relation(fields: [userId], references: [id])
  createdAt            DateTime     @default(now())
}

model Reception {
  id                   String       @id @default(uuid()) @db.Uuid
  reference String? @unique
  status Status
  createdBy String @db.Uuid
  supplierId String @db.Uuid
  supplier Supplier @relation(fields: [supplierId], references: [id])
  createdAt            DateTime     @default(now())
  updatedAt DateTime @updatedAt
  validatedAt DateTime?

  receptionLines ReceptionLine[]
}

model ReceptionLine {
  id               String @id @default(uuid()) @db.Uuid
  expectedQuantity Int
  receivedQuantity Int
  productId String @db.Uuid
  product Product @relation(fields: [productId], references: [id])
  locationId String @db.Uuid
  location Location @relation(fields: [locationId], references: [id])
  receptionId String @db.Uuid
  reception Reception @relation(fields: [receptionId], references: [id])
}

model Inventory { 
  id String @id @default(uuid()) @db.Uuid
  reference String @unique
  status InventoryStatut
  locationId String @db.Uuid  
  location Location @relation(fields: [locationId], references: [id]) 
  createdBy String @db.Uuid
  creator User @relation(fields: [createdBy], references: [id]) 
  inventoryItems InventoryItem[] 
  createdAt DateTime @default(now()) 
  updatedAt DateTime @updatedAt 
  validatedAt DateTime? 
  }

  model InventoryItem {
  id String @id @default(uuid()) @db.Uuid
  theoreticalQuantity Int
  countedQuantity     Int
  inventoryId String @db.Uuid
  productId   String @db.Uuid
  inventory Inventory @relation(fields: [inventoryId],references: [id])
  product Product @relation(fields: [productId],references: [id])
}