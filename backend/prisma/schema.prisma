generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Roles {
  ADMIN
  MANAGER
  OPERATOR
}

model User { 
  id    Int     @id @default(autoincrement()) 
  email String  @unique
  name String
  firstname String
  passwordhashed String
  role           Roles @default(OPERATOR)
  createdAt      DateTime @default(now())
} 